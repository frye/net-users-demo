+using System.Text.Json;
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.Extensions.Logging;
+using NetUsersApi.Controllers;
+using NetUsersApi.Tests.Infrastructure;
+using Xunit;
+
+namespace NetUsersApi.Tests.Controllers;
+
+[Trait("Workshop", "Delete")]
+public class DeleteUserTests : UserStoreTest
+{
+    [Fact]
+    public void ExistingIdReturnsNoContentAndRemovesUser()
+    {
+        var result = Assert.IsType<NoContentResult>(Controller.DeleteUser("1"));
+
+        Assert.Equal(204, result.StatusCode);
+        Assert.DoesNotContain(Users, user => user.Id == "1");
+        Assert.Equal(2, Users.Count);
+        Assert.IsType<NotFoundObjectResult>(Controller.GetUser("1").Result);
+    }
+
+    [Fact]
+    public void MissingIdReturnsExistingError()
+    {
+        var before = JsonSerializer.Serialize(Users);
+
+        var result = Assert.IsType<NotFoundObjectResult>(Controller.DeleteUser("missing"));
+
+        Assert.Equal(404, result.StatusCode);
+        Assert.Equal("{\"error\":\"User not found\"}", JsonSerializer.Serialize(result.Value));
+        Assert.Equal(before, JsonSerializer.Serialize(Users));
+    }
+
+    [Fact]
+    public void RepeatedDeleteReturnsExistingError()
+    {
+        Assert.IsType<NoContentResult>(Controller.DeleteUser("2"));
+
+        var repeated = Assert.IsType<NotFoundObjectResult>(Controller.DeleteUser("2"));
+
+        Assert.Equal(404, repeated.StatusCode);
+        Assert.Equal("{\"error\":\"User not found\"}", JsonSerializer.Serialize(repeated.Value));
+        Assert.Equal(2, Users.Count);
+    }
+
+    [Fact]
+    public void OtherUsersRemainUnchanged()
+    {
+        var before = JsonSerializer.Serialize(Users.Where(user => user.Id != "2"));
+
+        Assert.IsType<NoContentResult>(Controller.DeleteUser("2"));
+
+        Assert.Equal(before, JsonSerializer.Serialize(Users));
+    }
+
+    [Theory]
+    [InlineData("1")]
+    [InlineData("missing")]
+    public void LogsStructuredRequestWithUserId(string id)
+    {
+        var logger = new RecordingLogger();
+        var controller = new UsersController(logger);
+
+        controller.DeleteUser(id);
+
+        var entry = Assert.Single(logger.Entries);
+        Assert.Equal(LogLevel.Information, entry.Level);
+        Assert.Equal(id, entry.Values["UserId"]);
+        Assert.Equal("DELETE /api/v1/users/{UserId} endpoint called", entry.Values["{OriginalFormat}"]);
+    }
+
+    private sealed class RecordingLogger : ILogger<UsersController>
+    {
+        public List<(LogLevel Level, Dictionary<string, object?> Values)> Entries { get; } = [];
+
+        public IDisposable? BeginScope<TState>(TState state) where TState : notnull => null;
+        public bool IsEnabled(LogLevel logLevel) => true;
+
+        public void Log<TState>(LogLevel logLevel, EventId eventId, TState state,
+            Exception? exception, Func<TState, Exception?, string> formatter)
+        {
+            var values = Assert.IsAssignableFrom<IEnumerable<KeyValuePair<string, object?>>>(state);
+            Entries.Add((logLevel, values.ToDictionary(pair => pair.Key, pair => pair.Value)));
+        }
+    }
+}
